# =====================================================================
# 本机个人配置模板：复制为 application-local.yml 并填入真实值
# application.yml 通过 spring.config.import: optional:application-local.yml 加载
# 也可以改用环境变量：KG_DB_URL / KG_DB_USERNAME / KG_DB_PASSWORD / KG_STORAGE_ROOT
#                     KG_LLM_BASE_URL / KG_LLM_API_KEY / KG_LLM_MODEL / KG_OCR_MODE / KG_OCR_DATA_PATH
# =====================================================================
spring:
  datasource:
    url: jdbc:mysql://127.0.0.1:3306/knowledge_graph_dev?useUnicode=true&characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
    username: your_db_username
    password: your_db_password
  sql:
    init:
      mode: always
      schema-locations:
        - classpath:db/migration/V1__schema.sql
        - classpath:db/migration/V3__seed.sql
        - classpath:db/migration/V4__llm_profiles.sql
        - classpath:db/migration/V5__ingestion.sql
        - classpath:db/migration/V6__auto_organization.sql
        - classpath:db/migration/V7__document_metadata.sql
        - classpath:db/migration/V8__extraction_checkpoint.sql

kg:
  storage:
    root: E:/zhishitupu/database/extracted/storage
  # 模型地址与密钥在启动后的系统设置页面填写，不要提交真实密钥。
