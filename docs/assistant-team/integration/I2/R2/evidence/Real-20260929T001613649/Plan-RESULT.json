        },
        "sql": "WITH visible_nodes AS (SELECT n.id,n.canonical_name,n.node_type FROM knowledge_nodes n WHERE 1=1 AND EXISTS (SELECT 1 FROM library_nodes ln WHERE ln.node_id=n.id AND ln.library_id IN (:libraryIds))), visible_edges AS (SELECT e.id,e.source_node_id,e.target_node_id FROM knowledge_edges e JOIN visible_nodes s ON s.id=e.source_node_id JOIN visible_nodes t ON t.id=e.target_node_id WHERE e.status='active') , incident_endpoints AS (SELECT source_node_id AS node_id FROM visible_edges UNION ALL SELECT target_node_id AS node_id FROM visible_edges WHERE target_node_id<>source_node_id), node_degrees AS (SELECT node_id,COUNT(*) AS degree FROM incident_endpoints GROUP BY node_id) SELECT n.id,n.canonical_name,n.node_type,COALESCE(d.degree,0) AS degree FROM visible_nodes n LEFT JOIN node_degrees d ON d.node_id=n.id ORDER BY degree DESC,n.id LIMIT :limit",
        "libraryIds": [
          7901
        ],
        "limit": 10
